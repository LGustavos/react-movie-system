# TMDB API - Bearer Token (v4) OBRIGATORIO
# Gere em: https://www.themoviedb.org/settings/api
# Copie o valor de "API Read Access Token".
# ATENCAO: NAO usar prefixo NEXT_PUBLIC_ - o token nunca deve ir para o bundle do cliente.
# Todas as chamadas TMDB sao feitas via /api/tmdb (route handler) usando este token no servidor.
TMDB_TOKEN=coloque_seu_bearer_token_aqui

# (Opcional) sobrescreve a base da API
# TMDB_API_URL=https://api.themoviedb.org/3

# (Opcional) idioma retornado pelo TMDB
# TMDB_LANGUAGE=pt-BR
